# Copy outside the repository; generate a private token, do not use this placeholder.
NOTIFY_TOKEN=replace-with-a-random-token-at-least-32-characters-long
NOTIFY_SPEAKER="your exact Mijia speaker name"
NOTIFY_PORT=18766
NOTIFY_BACKEND=http://127.0.0.1:9393/speak
NOTIFY_DATABASE=/var/lib/task-notify/notifications.sqlite3
NOTIFY_TEXT_TEMPLATE="{source}，{task}，已完成。"
